# Supabase — obtain these from your Supabase project dashboard.
# Copy this file to my-app/.env.local and fill in real values.
# NEVER commit .env.local or any real key.

# Public client config (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. Used exclusively in my-app/src/lib/db.ts.
# Never reference in client code; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
