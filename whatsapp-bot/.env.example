# WhatsApp bridge configuration. Copy to .env for local runs;
# on a server, setup-vm.sh writes /etc/roktosathi-bridge/env instead.

# Shared secret. Must equal WHATSAPP_BOT_TOKEN in the Next.js app.
WHATSAPP_BOT_TOKEN=

# Port the bridge listens on (default 3001). PORT is used as a fallback.
BRIDGE_PORT=3001

# Where donor replies are interpreted. Local dev: http://localhost:3000/api/whatsapp/inbound
# Production: https://blood-gamma-nine.vercel.app/api/whatsapp/inbound
APP_INBOUND_URL=https://blood-gamma-nine.vercel.app/api/whatsapp/inbound

# Folder holding the linked-device session. On a server keep it OUTSIDE the
# checkout so redeploys never wipe the pairing, e.g. /var/lib/roktosathi-bridge
WWEBJS_DATA_PATH=.wwebjs_auth

# Optional: path to a system Chrome/Chromium. Empty = puppeteer's bundled build.
CHROME_PATH=

# Keep false on any public host: true lets anyone opening /qr link their phone.
QR_PUBLIC=false
